{"connections":{"Answer Ready?":{"main":[[{"index":0,"node":"Respond to Customer","type":"main"}],[{"index":0,"node":"Create Human Ticket","type":"main"}]]},"Classification OK?":{"main":[[{"index":0,"node":"Get Answer","type":"main"}],[{"index":0,"node":"Create Human Ticket","type":"main"}]]},"Classify Intent":{"main":[[{"index":0,"node":"Classification OK?","type":"main"}]]},"Create Human Ticket":{"main":[[{"index":0,"node":"Notify Human Support","type":"main"}]]},"Customer Message Webhook":{"main":[[{"index":0,"node":"Validate Input","type":"main"}]]},"Get Answer":{"main":[[{"index":0,"node":"Answer Ready?","type":"main"}]]},"Input Valid?":{"main":[[{"index":0,"node":"Classify Intent","type":"main"}],[{"index":0,"node":"Reject Request","type":"main"}]]},"Validate Input":{"main":[[{"index":0,"node":"Input Valid?","type":"main"}]]}},"name":"AI Customer Support Automation","nodes":[{"id":"1","name":"Customer Message Webhook","parameters":{"httpMethod":"POST","options":{},"path":"customer-support","responseMode":"responseNode"},"position":[240,300],"type":"n8n-nodes-base.webhook","typeVersion":2,"webhookId":"customer-support"},{"id":"2","name":"Validate Input","parameters":{"jsCode":"// Basic input validation + shared-secret check before anything touches the AI.\nconst item = $input.first().json;\nconst body = item.body || item;\nconst headers = item.headers || {};\nconst message = (body.message || '').toString();\nconst providedSecret = (headers['x-webhook-secret'] || '').toString();\nconst expectedSecret = ($env.WEBHOOK_SECRET || '').toString();\n\nlet valid = true;\nlet error = '';\nif (expectedSecret && providedSecret !== expectedSecret) {\n  valid = false; error = 'Unauthorized.';\n} else if (!message.trim()) {\n  valid = false; error = \"Field 'message' is required.\";\n} else if (message.length > 2000) {\n  valid = false; error = 'Message is too long (max 2000 characters).';\n}\n\nreturn [{ json: {\n  valid,\n  error,\n  message: message.trim(),\n  customer_id: body.customer_id || null,\n} }];"},"position":[480,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"3","name":"Input Valid?","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"c1","leftValue":"={{ $json.valid }}","operator":{"operation":"equals","type":"boolean"},"rightValue":true}]},"looseTypeValidation":true,"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"position":[720,300],"type":"n8n-nodes-base.if","typeVersion":2},{"id":"4","name":"Reject Request","parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.stringify({ error: $json.error || 'Invalid request.' }) }}","responseCode":400},"position":[960,480],"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1},{"id":"5","name":"Classify Intent","onError":"continueRegularOutput","parameters":{"authentication":"none","headerParameters":{"parameters":[{"name":"X-Webhook-Secret","value":"={{ $env.WEBHOOK_SECRET || '' }}"}]},"jsonBody":"={{ JSON.stringify({ message: $('Validate Input').first().json.message, customer_id: $('Validate Input').first().json.customer_id }) }}","method":"POST","options":{"timeout":20000},"sendBody":true,"sendHeaders":true,"specifyBody":"json","url":"={{ ($env.BACKEND_URL || 'http://localhost:8000') + '/api/classify' }}"},"position":[960,180],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"6","name":"Classification OK?","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"c1","leftValue":"={{ $json.classification.intent }}","operator":{"operation":"in","type":"string"},"rightValue":"faq, order_status"},{"id":"c2","leftValue":"={{ $json.classification.requires_human }}","operator":{"operation":"equals","type":"boolean"},"rightValue":false},{"id":"c3","leftValue":"={{ $json.classification.confidence }}","operator":{"operation":"largerEqual","type":"number"},"rightValue":0.6}]},"looseTypeValidation":true,"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"position":[1200,180],"type":"n8n-nodes-base.if","typeVersion":2},{"id":"7","name":"Get Answer","onError":"continueRegularOutput","parameters":{"authentication":"none","headerParameters":{"parameters":[{"name":"X-Webhook-Secret","value":"={{ $env.WEBHOOK_SECRET || '' }}"}]},"jsonBody":"={{ JSON.stringify({ message: $('Validate Input').first().json.message, classification: $json.classification }) }}","method":"POST","options":{"timeout":20000},"sendBody":true,"sendHeaders":true,"specifyBody":"json","url":"={{ ($env.BACKEND_URL || 'http://localhost:8000') + '/api/respond' }}"},"position":[1440,120],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"8","name":"Answer Ready?","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"c1","leftValue":"={{ $json.requires_human }}","operator":{"operation":"equals","type":"boolean"},"rightValue":false},{"id":"c2","leftValue":"={{ $json.answer }}","operator":{"operation":"exists","type":"string"}}]},"looseTypeValidation":true,"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"position":[1680,120],"type":"n8n-nodes-base.if","typeVersion":2},{"id":"9","name":"Respond to Customer","parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.stringify({ answer: $json.answer, requires_human: false }) }}","responseCode":200},"position":[1920,60],"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1},{"id":"10","name":"Create Human Ticket","parameters":{"jsCode":"// DEMO human handoff. In production this node would create a ticket in\n// Zendesk/Freshdesk or post to a Slack support channel instead of just\n// returning structured JSON.\nconst classification = $('Classification OK?').first().json.classification || {};\nconst message = $('Validate Input').first().json.message || '';\nconst ticket = {\n  ticket_id: 'T-' + Date.now().toString().slice(-6),\n  intent: classification.intent || 'unknown',\n  confidence: classification.confidence ?? 0,\n  reason: classification.reason || 'escalated by workflow',\n  customer_message: message.slice(0, 200),\n  status: 'open',\n  created_via: 'n8n-demo-handoff'\n};\nconsole.log('HUMAN HANDOFF (demo): ' + JSON.stringify(ticket));\nreturn [{ json: { ticket, requires_human: true } }];"},"position":[1920,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"11","name":"Notify Human Support","parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.stringify({ message: 'Thanks for reaching out — I have passed your request to our support team. They will get back to you shortly.', requires_human: true, ticket: $json.ticket }) }}","responseCode":200},"position":[2160,300],"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1},{"id":"12","name":"Note: demo backends","parameters":{"content":"## Demo notes\n- The backend (`src/`) runs on `BACKEND_URL` (default `http://localhost:8000`).\n- `Classify Intent` / `Get Answer` call the backend's mock AI + mock order/FAQ data.\n- `Create Human Ticket` is a demo handoff — wire it to Zendesk/Slack in production.","height":300,"width":420},"position":[240,560],"type":"n8n-nodes-base.stickyNote","typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"staticData":null}