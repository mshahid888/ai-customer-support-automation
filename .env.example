# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` file to git (it is listed in .gitignore).

# Which LLM backend to use: "mock" or "openai_compatible".
# "mock" = rule-based demo classifier, needs no API key (default).
# "openai_compatible" = any OpenAI-style /chat/completions endpoint
#   (OpenAI, Azure OpenAI, Ollama, LM Studio, ...).
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=openai_compatible.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Shared secret the n8n webhook must send as the `X-Webhook-Secret` header.
# Leave empty for local demos; set a long random value in production.
WEBHOOK_SECRET=

# Local API port.
PORT=8000

# Safety limits.
MAX_MESSAGE_LENGTH=2000
MAX_REQUEST_BODY_BYTES=65536

# Classifications below this confidence are routed to a human.
CONFIDENCE_THRESHOLD=0.6
